# Ollama local HTTP API
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=4096
VOICE_NUM_PREDICT=80

# Local Faster-Whisper model directory; model must be downloaded explicitly.
STT_MODEL_PATH=models/faster-whisper-base
# Optional higher-accuracy model used only for Hindi and Tamil; English keeps the faster base model.
STT_MULTILINGUAL_MODEL_PATH=models/faster-whisper-small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_BEAM_SIZE=5
STT_LANGUAGE_CONFIDENCE_THRESHOLD=0.55
# Omit STT_LANGUAGE to auto-detect; optionally set e.g. STT_LANGUAGE=en.
AUDIO_MAX_SIZE_MB=25
AUDIO_MAX_DURATION_SECONDS=300

# Local Piper voice and matching .onnx.json file; model must be downloaded explicitly.
TTS_MODEL_PATH=models/piper/en_US-norman-medium.onnx
# Optional; defaults to TTS_MODEL_PATH + .json
# TTS_CONFIG_PATH=models/piper/en_US-norman-medium.onnx.json
# Hindi/Tamil are deliberately not mapped to the English voice. Download and verify the
# Hindi model before uncommenting these reproducible paths on a new installation.
# TTS_HI_MODEL_PATH=models/piper/hi_IN-pratham-medium.onnx
# TTS_HI_CONFIG_PATH=models/piper/hi_IN-pratham-medium.onnx.json
# Piper 1.8.0's current catalog has no Tamil (ta_*) voice; leave unset.
# TTS_TA_MODEL_PATH=
# TTS_TA_CONFIG_PATH=
TTS_USE_CUDA=false
AUDIO_OUTPUT_DIR=generated_audio

SESSION_MAX_TURNS=12
SESSION_MAX_COUNT=500
LOG_LEVEL=INFO
